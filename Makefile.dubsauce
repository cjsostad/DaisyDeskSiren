# DubSauce — Seed3 Desktop MULTI-ENGINE build (siren + Synare), v0.5 stage 1
# The merged firmware. Does NOT touch the siren/synare bench Makefiles.
#   make -f Makefile.dubsauce              # build
#   make -f Makefile.dubsauce program-dfu  # flash (board in bootloader DFU)
# Replaces whatever app is on the Seed3 (BOOT_SRAM holds one app).
TARGET = DubSauce

DEBUG = 0
OPT = -O3

APP_TYPE = BOOT_SRAM

CPP_SOURCES = src/main_dubsauce.cpp

C_INCLUDES += -Isrc

LIBDAISY_DIR = libDaisy
DAISYSP_DIR  = DaisySP

USE_FATFS = 0

SYSTEM_FILES_DIR = $(LIBDAISY_DIR)/core

BOOT_BIN = $(SYSTEM_FILES_DIR)/dsy_bootloader_v6_4-extdfu-2000ms.bin

include $(SYSTEM_FILES_DIR)/Makefile
